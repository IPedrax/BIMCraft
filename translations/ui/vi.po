msgid "Click where the group's origin goes."
msgstr "Nhấp chỗ đặt gốc của nhóm."

#: crates/ui-egui/src/lib.rs:5078
msgid "Click where the line starts."
msgstr "Nhấp chỗ đường bắt đầu."

#: crates/ui-egui/src/properties.rs:1183
msgid "Click where the location line should run"
msgstr "Nhấp chỗ đường định vị sẽ chạy qua"

#: crates/ui-egui/src/draw.rs:588
msgid "Click where the middle of a side goes. Esc cancels."
msgstr "Nhấp chỗ đặt điểm giữa một cạnh. Esc để hủy."

#: crates/ui-egui/src/draw.rs:614
msgid "Click where the polyline starts."
msgstr "Nhấp chỗ đường đa tuyến bắt đầu."

#: crates/ui-egui/src/lib.rs:5020
msgid "Click where the radius goes. Esc cancels."
msgstr "Nhấp chỗ đặt bán kính. Esc để hủy."

#: crates/ui-egui/src/lib.rs:5036
msgid "Click where the ramp starts: the middle of its foot."
msgstr "Nhấp chỗ đường dốc bắt đầu: điểm giữa chân dốc."

#: crates/ui-egui/src/lib.rs:4996
msgid "Click where the repeating detail starts."
msgstr "Nhấp chỗ chi tiết lặp bắt đầu."

#: crates/ui-egui/src/lib.rs:5076
msgid "Click where the split line starts: a point, a corner or an edge of the top."
msgstr "Nhấp nơi đường chia bắt đầu: một điểm, một góc hoặc một cạnh của mặt trên."

#: crates/ui-egui/src/lib.rs:5032
msgid "Click where the stair starts: the middle of its first riser."
msgstr "Nhấp chỗ cầu thang bắt đầu: điểm giữa bậc đứng đầu tiên."

#: crates/ui-egui/src/lang.rs:28
msgid "Click which way it climbs: its risers take it up to the level above. Esc cancels."
msgstr "Nhấp hướng thang đi lên: các bậc đứng đưa nó lên tầng phía trên. Esc để hủy."

#: crates/ui-egui/src/lib.rs:5043
msgid "Click which way the next run goes from the landing: on, left, right, or back beside it."
msgstr "Nhấp hướng của vế tiếp theo từ chiếu nghỉ: thẳng, trái, phải hoặc quay ngược bên cạnh."

