#: crates/ui-egui/src/lib.rs:4805
msgid "Click to pick a point on the top."
msgstr "Kliknij, aby wybrać punkt na górze."

#: crates/ui-egui/src/lib.rs:4806
msgid "Click to select a built element in a view, move it with the drag, or Delete to remove it from the project."
msgstr "Kliknij, aby zaznaczyć zbudowany element w widoku, przesuń go przeciągnięciem, albo naciśnij Delete, aby usunąć go z projektu."

#: crates/ui-egui/src/lib.rs:4807
msgid "Click where the point goes."
msgstr "Kliknij miejsce, gdzie ma trafić punkt."

