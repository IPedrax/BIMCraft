msgstr "Kreis"

#: crates/ui-egui/src/editor.rs:776
msgid "Circle centre and radius"
msgstr "Kreismittelpunkt und Radius"

#: crates/ui-egui/src/draw.rs:158
msgid "Circle: click its centre, then a point on it (or only its centre, with Radius)"
msgstr "Kreis: Mittelpunkt und dann einen Punkt auf dem Kreis anklicken (oder nur den Mittelpunkt, mit Radius)"

#: crates/ui-egui/src/lib.rs:3823
msgid "Circulation"
msgstr "Verkehrsfläche"

#: crates/core/src/draw.rs:106
