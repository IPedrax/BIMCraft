msgid "Click a reference plane, a reference line or a form's edge: a line along it, locked to it."
msgstr "Clicca un piano di riferimento, una linea di riferimento o uno spigolo di una forma: una linea lungo di esso, bloccata a esso."

#: crates/ui-egui/src/editor/sketch.rs:1294
msgid "Click a reference plane, a reference line or a form's edge: a line along it."
msgstr "Clicca un piano di riferimento, una linea di riferimento o uno spigolo di una forma: una linea lungo di esso."

#: crates/ui-egui/src/editor/sketch.rs:1284
msgid "Click a reference plane, a reference line or a form's edge: a line of the path along it."
msgstr "Clicca un piano di riferimento, una linea di riferimento o uno spigolo di una forma: una linea del percorso lungo di esso."

#: crates/ui-egui/src/lib.rs:5472
