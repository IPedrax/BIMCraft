#: crates/ui-egui/src/publisher.rs:887
msgid "Clear"
msgstr "Cancella"

#: crates/ui-egui/src/graphics.rs:1074
msgid "Clear Overrides"
msgstr "Cancella sostituzioni"

#: crates/ui-egui/src/recent.rs:147
msgid "Clear Recent Files"
msgstr "Cancella file recenti"

#: crates/ui-egui/src/browser.rs:315
