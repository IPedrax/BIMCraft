msgstr ""

#: crates/ui-egui/src/lib.rs:4172
msgid "Click where the group's origin goes."
msgstr "Klikněte do místa počátku skupiny."

#: crates/ui-egui/src/lib.rs:4242
msgid "Click where the line starts."
msgstr "Klikněte do místa, kde začíná čára."

#: crates/ui-egui/src/draw.rs:569
msgid "Click where the middle of a side goes. Esc cancels."
msgstr "Klikněte do místa středu strany. Klávesa Esc operaci zruší."

#: crates/ui-egui/src/draw.rs:595
msgid "Click where the polyline starts."
msgstr "Klikněte do místa, kde začíná křivka."

#: crates/ui-egui/src/lib.rs:4197
msgid "Click where the radius goes. Esc cancels."
msgstr "Klikněte do místa poloměru. Klávesa Esc operaci zruší."

#: crates/ui-egui/src/lib.rs:4210
msgid "Click where the ramp starts: the middle of its foot."
msgstr "Klikněte do místa nástupu rampy: střed její paty."

#: crates/ui-egui/src/lib.rs:4173
msgid "Click where the repeating detail starts."
msgstr "Klikněte do místa, kde začíná opakovaný detail."

#: crates/ui-egui/src/lib.rs:4206
msgid "Click where the stair starts: the middle of its first riser."
msgstr "Klikněte do místa nástupu schodiště: střed první podstupnice."

#: crates/ui-egui/src/lang.rs:21
msgid "Click which way it climbs: its risers take it up to the level above. Esc cancels."
msgstr "Klikněte pro směr stoupání: podstupnice vyvedou rameno do podlaží výše. Klávesa Esc operaci zruší."

#: crates/ui-egui/src/lib.rs:4217
msgid "Click which way the next run goes from the landing: on, left, right, or back beside it."
msgstr "Klikněte pro určení směru dalšího ramene z podesty: rovně, vlevo, vpravo nebo zpět vedle něj."

