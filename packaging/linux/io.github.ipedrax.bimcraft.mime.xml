<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info has no type for any of these, so BIMCraft declares them. application/x-bimcraft is
     the content type the Windows installer registers for a project: .bimc, and .bimt and .bimb, which hold
     the same JSON, and .bimcraft, which versions before the short names wrote. A family is a .bimf. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-bimcraft">
    <comment>BIMCraft project</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="io.github.ipedrax.bimcraft"/>
    <glob pattern="*.bimc"/>
    <glob pattern="*.bimt"/>
    <glob pattern="*.bimb"/>
    <glob pattern="*.bimcraft"/>
  </mime-type>
  <mime-type type="application/x-bimcraft-family">
    <comment>BIMCraft family</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="io.github.ipedrax.bimcraft"/>
    <glob pattern="*.bimf"/>
  </mime-type>
  <mime-type type="application/x-ifc">
    <comment>IFC building model</comment>
    <sub-class-of type="text/plain"/>
    <!-- An IFC file is ISO 10303-21 (STEP) text. -->
    <magic priority="50"><match type="string" value="ISO-10303-21;" offset="0"/></magic>
    <glob pattern="*.ifc"/>
  </mime-type>
</mime-info>
